    {
      "cell_type": "code",
      "source": [
        "# Implementación propia con tamaño fijo de chunks, por si no queremos usar LangChain\n",
        "\n",
        "def chunk_text_manual(text):\n",
        "    chunks = []\n",
        "    start = 0\n",
        "    chunk_size = 500\n",
        "    overlap = 50\n",
        "    while start < len(text):\n",
        "        end = start + chunk_size\n",
        "        chunks.append(text[start:end])\n",
        "        start += chunk_size - overlap\n",
        "    return chunks"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 17
