    {
      "cell_type": "code",
      "source": [
        "# Tercera prueba.\n",
        "# Cambio en el prompt para incluir few-shot e instrucciones más detalladas\n",
        "# Cambio para recuperar chunks utilizando similitud conseno\n",
        "\n",
        "from sklearn.neighbors import NearestNeighbors\n",
        "\n",
        "closest_chunks_cosine = NearestNeighbors(metric=\"cosine\")\n",
        "closest_chunks_cosine.fit(chunks_embeddings)\n",
        "\n",
        "def recuperar_chunks_cosine(query, n_chunks=3):\n",
        "    distances, indices = closest_chunks_cosine.kneighbors(\n",
        "        model_emb.encode(query).reshape(1, -1),\n",
        "        n_neighbors=n_chunks,\n",
        "        return_distance=True\n",
        "    )\n",
        "    data = [chunks[i] for i in indices[0]]\n",
        "    return data\n",
        "\n",
        "resultados = recuperar_chunks_cosine(\"query: ¿Cuáles son las fronteras del espacio Schengen?\")\n",
        "print(resultados)"
      ],
