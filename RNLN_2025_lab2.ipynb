        "# Segunda prueba, cambiamos a un LLM menor, Llama 3.2 3B Instruct\n",
        "\n",
        "from transformers import AutoTokenizer, AutoModelForCausalLM, BitsAndBytesConfig\n",
        "import torch\n",
        "import os\n",
        "\n",
        "model_repo = \"meta-llama/Llama-3.2-3B-Instruct\"\n",
        "\n",
        "# Conectar a Drive\n",
        "from google.colab import drive\n",
        "drive.mount('/content/drive')\n",
        "\n",
        "# Ruta del cache de HuggingFace\n",
        "HF_CACHE = \"/content/drive/MyDrive/hf_cache\"\n",
        "\n",
        "# Tokenizer\n",
        "tokenizer_exp2 = AutoTokenizer.from_pretrained(\n",
        "    model_repo,\n",
        "    cache_dir=HF_CACHE\n",
        ")\n",
        "\n",
        "# Config 4-bit\n",
        "bnb_config_exp2 = BitsAndBytesConfig(\n",
        "    load_in_4bit=True,\n",
        "    bnb_4bit_quant_type=\"nf4\",\n",
        "    bnb_4bit_compute_dtype=torch.bfloat16\n",
        ")\n",
        "\n",
        "# Modelo\n",
