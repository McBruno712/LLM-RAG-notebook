    {
      "cell_type": "code",
      "source": [
        "def create_prompt_exp3(question, cant_chunks_cercanos, tokenizer):\n",
        "  question = \"query: \" + question\n",
        "  chunks_cercanos = recuperar_chunks_cosine(question, cant_chunks_cercanos)\n",
        "  context_str = \"\\n\\n---\\n\\n\".join(chunks_cercanos)\n",
        "  messages = [\n",
        "    {\n",
        "        \"role\": \"system\",\n",
        "        \"content\": \"\"\"Eres un asistente experto en el Acuerdo de Schengen, el espacio Schengen y la Unión Europea.\n",
        "        Solo puedes utilizar la información presente en los fragmentos de contexto que se te proporcionan.\n",
        "        Si la respuesta a la pregunta NO está claramente contenida en el contexto, o la pregunta está fuera del\n",
        "        dominio de Schengen/Unión Europea, debes responder exactamente: \"Lo siento, no cuento con información para responder esa pregunta.\".\n",
        "        \"\"\"\n",
        "    },\n",
        "    # Ejemplo 1 (en el dominio, respuesta encontrada en el contexto)\n",
        "    {\n",
        "        \"role\": \"user\",\n",
        "        \"content\": \"\"\"\n",
        "                Contexto: El Acuerdo de Schengen se firmó en 1985 entre varios países europeos con el objetivo de suprimir los controles en las fronteras interiores.\\n\\n\n",
        "                Pregunta: ¿En qué año se firmó el Acuerdo de Schengen?\\n\\n\n",
        "                Responde SOLO usando el contexto.\"\"\"\n",
        "    },\n",
        "    {\n",
        "        \"role\": \"assistant\",\n",
        "        \"content\": \"El Acuerdo de Schengen se firmó en 1985.\"\n",
        "    },\n",
        "    # Ejemplo 2 (fuera de dominio, debe negarse a responder)\n",
        "    {\n",
        "        \"role\": \"user\",\n",
        "        \"content\":\n",
        "            \"\"\"Contexto: El texto describe únicamente el Acuerdo de Schengen y la libre circulación dentro de Europa.\\n\\n\"\n",
        "            Pregunta: ¿Quién ganó la Copa Mundial de la FIFA 2022?\\n\\n\n",
        "            Responde SOLO usando el contexto.\"\"\"\n",
        "    },\n",
        "    {\n",
        "        \"role\": \"assistant\",\n",
        "        \"content\": \"Lo siento, no cuento con información para responder esa pregunta.\"\n",
        "    },\n",
        "    # Ejemplo real (lo que queremos que responda ahora)\n",
        "    {\n",
        "        \"role\": \"user\",\n",
        "            \"content\": (\n",
        "                \"A continuación se te proporciona contexto relevante extraído de artículos sobre el Acuerdo de Schengen y la Unión Europea.\\n\\n\"\n",
        "                f\"Contexto:\\n{context_str}\\n\\n\"\n",
        "                f\"Pregunta: {question}\\n\\n\"\n",
        "                \"Responde SOLO usando el contexto. Si no puedes responder, utiliza exactamente la frase: \"\n",
        "                \"\\\"Lo siento, no cuento con información para responder esa pregunta.\\\"\"\n",
        "            )\n",
        "    }\n",
        "  ]\n",
        "\n",
        "  prompt = tokenizer.apply_chat_template(messages, tokenize=False, add_generation_prompt=True)\n",
        "\n",
        "  return prompt"
      ],
