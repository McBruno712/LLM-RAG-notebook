        "def recuperar_chunks(query, n_chunks=3):\n",
        "  data = []\n",
        "  results = closest_chunks.kneighbors(model_emb.encode(query).reshape(1,-1), n_neighbors=n_chunks, return_distance=False).ravel()\n",
        "  for i in range(n_chunks):\n",
        "    data.append(chunks[results[i]])\n",
        "  return data\n",
        "\n",
        "resultados = recuperar_chunks(\"query: ¿Cuáles son las fronteras del espacio Schengen?\")\n",
        "print(resultados)"
      ],
